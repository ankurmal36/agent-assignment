# ==============================================================================
# CloudOps Sentinel - Environment Configuration Template
# Never commit actual secrets to version control. In production, secrets are
# injected via Google Cloud Secret Manager (see sentinel_agent/storage/secret_manager.py).
# ==============================================================================

# Google AI Studio / Gemini API Configuration
GEMINI_API_KEY=""
GOOGLE_GENAI_USE_VERTEXAI="FALSE"

# Google Cloud Platform & Secret Manager Settings
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"
USE_SECRET_MANAGER="FALSE"
GEMINI_SECRET_ID="sentinel-gemini-api-key"
ENABLE_CLOUD_DLP="FALSE"

# Strategic Model Routing Tiers
ROUTER_MODEL_FLASH="gemini-2.5-flash"
SYNTHESIS_MODEL_PRO="gemini-2.5-pro"

# Persistence & Context Window Management
SQLITE_DB_PATH="data/sentinel_state.db"
VECTOR_INDEX_PATH="data/runbook_vectors.json"
MAX_CONTEXT_TOKENS="4096"
SLIDING_WINDOW_TURNS="8"

# Observability & OpenTelemetry
OTEL_SERVICE_NAME="cloudops-sentinel-agent"
LOG_LEVEL="INFO"
